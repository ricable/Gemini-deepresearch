{
  "name": "gemini-deep-research-agent",
  "version": "1.0.0",
  "description": "A powerful deep research AI agent using Google Gemini API with iterative research, reflection, and comprehensive report generation",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "deep-research": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "dev": "node --watch src/cli.js",
    "research": "node src/cli.js",
    "test": "node --test src/**/*.test.js",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "gemini",
    "ai",
    "research",
    "agent",
    "deep-research",
    "llm",
    "google",
    "ruvector"
  ],
  "author": "ruvnet",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "node-fetch": "^3.3.2",
    "ora": "^8.1.0",
    "marked": "^14.1.0",
    "lru-cache": "^11.0.0"
  },
  "optionalDependencies": {
    "@ruvector/ruvllm": "^1.0.0",
    "ruvector": "^1.0.0"
  },
  "devDependencies": {
    "eslint": "^9.15.0",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ruvnet/gemini-deep-research-agent"
  }
}
