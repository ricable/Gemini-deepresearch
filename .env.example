# Gemini Deep Research Agent Configuration
# Copy this file to .env and fill in your values

# Required: Your Gemini API Key from Google AI Studio
# Get it at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Model Configuration
# Available models: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: Research Parameters
# Depth: How deep to go in iterative research (1-5, default: 3)
RESEARCH_DEPTH=3

# Breadth: How many parallel search queries per iteration (1-10, default: 5)
RESEARCH_BREADTH=5

# Max Iterations: Maximum research loop iterations (1-20, default: 10)
MAX_ITERATIONS=10

# Optional: API Configuration
# Concurrent API calls limit
CONCURRENCY_LIMIT=5

# Max output tokens per request
MAX_OUTPUT_TOKENS=65536

# Optional: Output Configuration
# Output format: markdown, json, html
OUTPUT_FORMAT=markdown

# Save reports to file
SAVE_REPORTS=true
REPORTS_DIR=./reports

# Optional: Debug mode
DEBUG=false
